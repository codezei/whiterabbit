doctype html
block html
    html(lang=lang)
        head
            block head
                - const domain = "https://whiterabbitcleaning.pl/"
                meta(charset="UTF-8")
                meta(name="viewport" content="width=device-width, initial-scale=1.0")
                meta(http-equiv="X-UA-Compatible" content="ie=edge")
                meta(name="theme-color" content=themeColor)
                title= pageTitle
                link(rel="preload" as="image" href="img/main-bg-xs.webp" fetchpriority="high" media="(max-width: 575px)")
                block fonts
                //- link(
                //-     rel="preload"
                //-     href="css/style.min.css?v=3.0.1"
                //-     as="style"
                //- )
                link(rel="stylesheet" href="css/main.min.css?v=4.0.5")
                link(rel="stylesheet" href="css/libs.min.css?v=4.0.5" media="print" onload="this.media='all'")
                link(rel="icon" href="img/favicon.ico" type="image/x-icon")
                link(rel="canonical", href= domain + pageUrl)
                meta(name="description", content=pageDescription)
                meta(name="keywords", content=pageKeywords)
                meta(property="og:title", content=pageTitle)
                meta(property="og:description", content=pageDescription)
                meta(property="og:type" content="website")
                meta(property="og:url", content= domain + pageUrl)
                meta(property="og:image", content= domain + pageImage)
                meta(name="twitter:card" content="summary_large_image")
                meta(name="twitter:title", content=pageTitle)
                meta(name="twitter:description", content=pageDescription)
                meta(name="twitter:image", content= domain + twitterImage)
                link(rel='alternate' hreflang='pl' href= domain)
                link(rel='alternate' hreflang='uk' href= domain + 'index-ua.html')
                link(rel='alternate' hreflang='x-default' href= domain)
