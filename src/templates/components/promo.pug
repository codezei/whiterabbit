section.promo#promo.section
    picture.promo__bg
        source(type="image/webp" srcset="img/main-bg-xs.webp" media="(max-width: 430px)")
        source(srcset="img/main-bg-xs.png" media="(max-width: 430px)")
        source(type="image/webp" srcset="img/main-bg.webp")
        img(src="img/main-bg.png", alt="", fetchpriority="high")
    .container
        .section__body.block
            .promo__content
                .promo__pre-title.pre-title.text-primary ✦ Profesjonalne czyszczenie tapicerki
                h1.promo__title Pranie tapicerki meblowej i tapicerki samochodowej, materacy, dywanów, i mycie okien&nbsp;
                    include cities
                h2.h3.text-light Skutecznie usuwamy brud, plamy i nieprzyjemne zapachy, korzystając z profesjonalnego sprzętu i starannie dobranej chemii
                .promo__list
                    ul.list-row
                        li.card.card-white.card-rounded ✦ Profesjonalny sprzęt
                        li.card.card-white.card-rounded ✦ Bezpieczna chemia
                        li.card.card-white.card-rounded ✦ Dojazd do klienta
                .promo__rating
                    span.rating(style="--star-rating: 4.8;")
                    b.text-bold 4.8
                    a.text-muted(href="#reviews") (56 reviews)
        .section__footer
            .section__shape.section__shape-bottom.section__inner
                .section__btn
                    include cta-button
