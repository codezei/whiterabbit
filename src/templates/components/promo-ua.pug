section.promo#promo.section
    picture.promo__bg
        source(type="image/webp" srcset="img/main-bg-xs.webp" media="(max-width: 430px)")
        source(srcset="img/main-bg-xs.png" media="(max-width: 430px)")
        source(type="image/webp" srcset="img/main-bg.webp")
        img(src="img/main-bg.png", alt="Чистий диван після професійної хімчистки оббивки", fetchpriority="high")
    .container
        .section__body.block
            .promo__content
                .promo__pre-title.pre-title.text-primary ✦ Професійна хімчистка
                h1.promo__title.text-uppercase Хімчистка оббивки, матраців, килимів та миття вікон&nbsp;
                    include cities-ua
                p.h3.text-light Ефективно видаляємо бруд, плями та неприємні запахи, використовуючи професійне обладнання та ретельно підібрані засоби для чищення.
                .promo__list
                    ul.list-row
                        li.card.card-white.card-rounded ✦ Професійне обладнання
                        li.card.card-white.card-rounded ✦ Безпечні засоби
                        li.card.card-white.card-rounded ✦ Виїзд до клієнта
                .promo__rating
                    span.rating(style="--star-rating: 4.8;")
                    b.text-bold 4.8
                    a.text-muted(href="#reviews") (20 відгуків)
        .section__footer
            .section__shape.section__shape-bottom.section__inner
                .section__btn
                    include cta-button-ua
